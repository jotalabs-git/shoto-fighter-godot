# Local tooling (Godot binary, etc.) — not committed
.tools/

# Godot 4+ specific ignores
.godot/
/android/
/export/
export_presets.cfg

# Imported assets cache
*.import
# Keep the model animation import settings for fresh clones.
!/assets/models/*.glb.import

# gdUnit4 reports
/reports/*
!/reports/.gdignore
test_results.xml

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

capture.png

/tools/*
!/tools/blender/
*.blend1
__pycache__/
.render-cache.json

# Librerías de audio externas instaladas localmente; no subir Sonic/GDC ni CC-BY sin auditoría.
/assets/audio/local/
